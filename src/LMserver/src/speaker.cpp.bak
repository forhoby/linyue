#include "rclcpp/rclcpp.hpp"
#include "std_msgs/msg/int16_multi_array.hpp"
#include <alsa/asoundlib.h>
#include <vector>
#include <thread>
#include <mutex>
#include <atomic>
#include <chrono>
#include <sched.h>

#define Speaker "hw:1,0"

// 循环缓冲区类
class CircularBuffer {
private:
    std::vector<int16_t> buffer_;
    size_t capacity_;
    size_t head_;  // 写入位置
    size_t tail_;  // 读取位置
    size_t size_;  // 当前缓冲区中的数据量
    std::mutex mutex_;

public:
    CircularBuffer(size_t capacity) : capacity_(capacity), head_(0), tail_(0), size_(0) {
        buffer_.resize(capacity);
    }

    // 写入数据到缓冲区
    size_t write(const int16_t *data, size_t count) {
        std::lock_guard<std::mutex> lock(mutex_);
        
        // 计算可写入的空间
        size_t available = capacity_ - size_;
        size_t write_count = std::min(count, available);
        
        if (write_count == 0) {
            // 缓冲区已满，丢弃多余的数据
            return 0;
        }
        
        // 分两次写入（如果需要）
        size_t first_part = std::min(write_count, capacity_ - head_);
        size_t second_part = write_count - first_part;
        
        // 写入第一部分
        std::copy(data, data + first_part, buffer_.data() + head_);
        head_ = (head_ + first_part) % capacity_;
        
        // 写入第二部分
        if (second_part > 0) {
            std::copy(data + first_part, data + write_count, buffer_.data());
            head_ = second_part;
        }
        
        size_ += write_count;
        return write_count;
    }

    // 从缓冲区读取数据
    size_t read(int16_t *data, size_t count) {
        std::lock_guard<std::mutex> lock(mutex_);
        
        // 计算可读取的数据量
        size_t read_count = std::min(count, size_);
        
        if (read_count == 0) {
            // 缓冲区为空
            return 0;
        }
        
        // 分两次读取（如果需要）
        size_t first_part = std::min(read_count, capacity_ - tail_);
        size_t second_part = read_count - first_part;
        
        // 读取第一部分
        std::copy(buffer_.data() + tail_, buffer_.data() + tail_ + first_part, data);
        tail_ = (tail_ + first_part) % capacity_;
        
        // 读取第二部分
        if (second_part > 0) {
            std::copy(buffer_.data(), buffer_.data() + second_part, data + first_part);
            tail_ = second_part;
        }
        
        size_ -= read_count;
        return read_count;
    }

    // 获取当前缓冲区中的数据量
    size_t size() {
        std::lock_guard<std::mutex> lock(mutex_);
        return size_;
    }

    // 获取缓冲区容量
    size_t capacity() {
        return capacity_;
    }

    // 清空缓冲区
    void clear() {
        std::lock_guard<std::mutex> lock(mutex_);
        head_ = 0;
        tail_ = 0;
        size_ = 0;
    }
};

class SpeakerNode : public rclcpp::Node {
private:
    rclcpp::Subscription<std_msgs::msg::Int16MultiArray>::SharedPtr subscription_;
    // 音频设备（hw:0,0）
    snd_pcm_t *pcm_handle_;
    snd_pcm_stream_t stream_;
    snd_pcm_format_t format_;
    unsigned int rate_;
    unsigned int channels_;
    unsigned int frames_;
    
    // 音频缓冲区（30秒）
    CircularBuffer buffer_;
    
    // 播放线程
    std::thread playback_thread_;
    std::atomic<bool> running_;
    
    // 上次监控时间
    std::chrono::steady_clock::time_point last_monitor_time_;
    // 累计接收到的样本数
    size_t total_received_;
    // 累计播放的样本数
    size_t total_played_;

public:
    SpeakerNode() : Node("speaker_node"), buffer_(16000 * 30), running_(true), total_received_(0), total_played_(0) {
        // 初始化 ALSA
        init_alsa();

        // 订阅音频回复主题
        subscription_ = this->create_subscription<std_msgs::msg::Int16MultiArray>(
            "/robot/audio_reply", 10, 
            std::bind(&SpeakerNode::audio_callback, this, std::placeholders::_1));

        // 启动播放线程
        playback_thread_ = std::thread(&SpeakerNode::playback_loop, this);
        
        // 设置播放线程优先级
        set_thread_priority(playback_thread_);

        // 初始化监控时间
        last_monitor_time_ = std::chrono::steady_clock::now();

        RCLCPP_INFO(this->get_logger(), "Speaker node started, listening to /robot/audio_reply");
    }

    ~SpeakerNode() {
        running_ = false;
        if (playback_thread_.joinable()) {
            playback_thread_.join();
        }
        
        // 关闭音频设备
        if (pcm_handle_) {
            snd_pcm_drain(pcm_handle_);
            snd_pcm_close(pcm_handle_);
        }
    }

private:
    // 设置线程优先级
    void set_thread_priority(std::thread &thread) {
        struct sched_param param;
        param.sched_priority = sched_get_priority_max(SCHED_FIFO) - 10;
        pthread_setschedparam(thread.native_handle(), SCHED_FIFO, &param);
    }

    void init_alsa() {
        int err;
        
        // 打开 PCM 设备（hw:0,0）
        stream_ = SND_PCM_STREAM_PLAYBACK;
        const char *device = Speaker; // 使用指定的硬件设备
        err = snd_pcm_open(&pcm_handle_, device, stream_, 0);
        if (err < 0) {
            RCLCPP_ERROR(this->get_logger(), "Error: Could not open %s PCM device: %s", device, snd_strerror(err));
            return;
        }

        // 配置 PCM 参数
        format_ = SND_PCM_FORMAT_S16_LE; // 16位 PCM
        rate_ = 16000; // 16kHz（与大模型返回的格式匹配）
        unsigned int channels = 1; // 单声道（与大模型返回的格式匹配）
        frames_ = 320; // 帧大小

        snd_pcm_hw_params_t *hw_params;
        snd_pcm_hw_params_alloca(&hw_params);

        err = snd_pcm_hw_params_any(pcm_handle_, hw_params);
        if (err < 0) {
            RCLCPP_ERROR(this->get_logger(), "Error: Could not get hw params: %s", snd_strerror(err));
            snd_pcm_close(pcm_handle_);
            pcm_handle_ = nullptr;
            return;
        }

        err = snd_pcm_hw_params_set_access(pcm_handle_, hw_params, SND_PCM_ACCESS_RW_INTERLEAVED);
        if (err < 0) {
            RCLCPP_ERROR(this->get_logger(), "Error: Could not set access: %s", snd_strerror(err));
            snd_pcm_close(pcm_handle_);
            pcm_handle_ = nullptr;
            return;
        }

        err = snd_pcm_hw_params_set_format(pcm_handle_, hw_params, format_);
        if (err < 0) {
            RCLCPP_ERROR(this->get_logger(), "Error: Could not set format: %s", snd_strerror(err));
            snd_pcm_close(pcm_handle_);
            pcm_handle_ = nullptr;
            return;
        }

        err = snd_pcm_hw_params_set_rate_near(pcm_handle_, hw_params, &rate_, 0);
        if (err < 0) {
            RCLCPP_ERROR(this->get_logger(), "Error: Could not set rate: %s", snd_strerror(err));
            snd_pcm_close(pcm_handle_);
            pcm_handle_ = nullptr;
            return;
        }

        err = snd_pcm_hw_params_set_channels(pcm_handle_, hw_params, channels);
        if (err < 0) {
            RCLCPP_WARN(this->get_logger(), "Warning: Could not set mono channels: %s", snd_strerror(err));
            // 尝试立体声
            channels = 2;
            err = snd_pcm_hw_params_set_channels(pcm_handle_, hw_params, channels);
            if (err < 0) {
                RCLCPP_ERROR(this->get_logger(), "Error: Could not set stereo channels: %s", snd_strerror(err));
                snd_pcm_close(pcm_handle_);
                pcm_handle_ = nullptr;
                return;
            }
        }

        // 优化 ALSA 缓冲区配置（调整为更稳定的参数）
        unsigned int periods = 8; // 增加 periods 数量，提高稳定性
        snd_pcm_uframes_t period_size = 512; // 调整 period_size，平衡延迟和稳定性

        err = snd_pcm_hw_params_set_period_size_near(pcm_handle_, hw_params, &period_size, nullptr);
        if (err < 0) {
            RCLCPP_WARN(this->get_logger(), "Warning: Could not set period size: %s", snd_strerror(err));
        }

        err = snd_pcm_hw_params_set_periods_near(pcm_handle_, hw_params, &periods, nullptr);
        if (err < 0) {
            RCLCPP_WARN(this->get_logger(), "Warning: Could not set periods: %s", snd_strerror(err));
        }

        err = snd_pcm_hw_params(pcm_handle_, hw_params);
        if (err < 0) {
            RCLCPP_ERROR(this->get_logger(), "Error: Could not set hw params: %s", snd_strerror(err));
            snd_pcm_close(pcm_handle_);
            pcm_handle_ = nullptr;
            return;
        }

        RCLCPP_INFO(this->get_logger(), "Audio device hw:0,0 initialized: %s, %dHz, %d channels", device, rate_, channels);
        RCLCPP_INFO(this->get_logger(), "ALSA buffer config: period_size=%zu, periods=%u", period_size, periods);
    }

    void audio_callback(const std_msgs::msg::Int16MultiArray::SharedPtr msg) {
        try {
            const std::vector<int16_t> &audio_data = msg->data;
            size_t data_size = audio_data.size();

            if (data_size == 0) {
                return;
            }

            // 打印接收到的音频数据信息
            total_received_ += data_size;
            RCLCPP_DEBUG(this->get_logger(), "Received audio data: %zu samples, total received: %zu", data_size, total_received_);

            // 写入数据到缓冲区
            size_t written = buffer_.write(audio_data.data(), data_size);
            if (written < data_size) {
                RCLCPP_WARN(this->get_logger(), "Buffer full, dropped %zu samples", data_size - written);
            }

        } catch (const std::exception &e) {
            RCLCPP_ERROR(this->get_logger(), "Error in audio callback: %s", e.what());
        }
    }

    // 播放循环线程
    void playback_loop() {
        const size_t buffer_size = 320; // 20ms of audio at 16kHz
        std::vector<int16_t> playback_buffer(buffer_size);

        while (running_) {
            // 从缓冲区读取数据
            size_t read = buffer_.read(playback_buffer.data(), buffer_size);
            
            if (read > 0) {
                // 播放音频数据
                if (pcm_handle_) {
                    snd_pcm_sframes_t frames_written = snd_pcm_writei(
                        pcm_handle_, 
                        playback_buffer.data(), 
                        read
                    );

                    if (frames_written < 0) {
                        // 处理错误
                        frames_written = snd_pcm_recover(pcm_handle_, frames_written, 0);
                        if (frames_written < 0) {
                            RCLCPP_ERROR(this->get_logger(), "Error writing to audio device: %s", snd_strerror(frames_written));
                        }
                    } else {
                        total_played_ += frames_written;
                        RCLCPP_DEBUG(this->get_logger(), "Played %zu samples, total played: %zu", frames_written, total_played_);
                    }
                }

                // 控制播放速率（使用更精确的时间控制）
                std::this_thread::sleep_for(std::chrono::milliseconds(20));
            } else {
                // 缓冲区为空，等待一段时间
                std::this_thread::sleep_for(std::chrono::milliseconds(500));
                RCLCPP_WARN(this->get_logger(), "Buffer underrun, waiting for data");
            }

            // 定期监控缓冲区状态
            monitor_buffer_status();
        }
    }

    // 监控缓冲区状态
    void monitor_buffer_status() {
        auto now = std::chrono::steady_clock::now();
        auto elapsed = std::chrono::duration_cast<std::chrono::seconds>(now - last_monitor_time_).count();
        
        if (elapsed >= 5) { // 每5秒监控一次
            size_t current_size = buffer_.size();
            size_t capacity = buffer_.capacity();
            float usage_percent = (float)current_size / capacity * 100;
            
            RCLCPP_INFO(this->get_logger(), "Buffer status: %.2f%% full (%zu / %zu samples)", 
                        usage_percent, current_size, capacity);
            RCLCPP_INFO(this->get_logger(), "Statistics: received=%zu samples, played=%zu samples", 
                        total_received_, total_played_);
            
            last_monitor_time_ = now;
        }
    }
};

int main(int argc, char *argv[]) {
    rclcpp::init(argc, argv);
    auto node = std::make_shared<SpeakerNode>();
    rclcpp::spin(node);
    rclcpp::shutdown();
    return 0;
}